
# Reading the answers back (scripts/export-rsvp.mjs only, never the browser).
# NO VITE_ PREFIX — a VITE_* name would be inlined into the shipped bundle, and
# this key bypasses row-level security on the whole project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# /coming sign-in. VITE_ on purpose — the check runs in the browser, so these
# ship in the bundle. The password is stored as its SHA-256 digest so the value
# itself is never readable in the shipped JS; regenerate with
#   printf '%s' 'the-password' | sha256sum
VITE_COMING_USERNAME=the-username
VITE_COMING_PASSWORD_SHA256=sha256-digest-of-the-password
